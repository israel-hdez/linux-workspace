#!/bin/env zsh

# Install Claude Code using the recommended
# native install. Updates are automatic or via
# claude CLI itself, so this script only installs
# if claude is not present already.
if ! command -v claude >/dev/null 2>&1; then
  curl -fsSL https://claude.ai/install.sh | bash
else
  echo "Claude CLI is already installed. For updating, use 'claude update' command."
fi
